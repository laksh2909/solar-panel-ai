# Environment Configuration for Solar Panel AI Inspection System
# Copy this file to .env and adjust variables as needed for local or container deployment.

# ==============================================================================
# Database Configuration
# ==============================================================================
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<dbname>
# For local Docker or standalone testing, SQLite fallback is enabled by default:
# DATABASE_URL=sqlite:///data/solar_panel_ai.db
# For production PostgreSQL:
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/solar_panel_ai

# ==============================================================================
# Backend API Configuration
# ==============================================================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ==============================================================================
# Frontend Configuration
# ==============================================================================
FRONTEND_PORT=3000

# Browser-facing API endpoint URL for Next.js frontend requests.
# LOCAL Docker Compose (default):
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ==============================================================================
# AWS EC2 Deployment (Phase 20)
# ==============================================================================
# Set EC2_PUBLIC_IP to your EC2 instance public IP address.
# deploy.sh reads this and writes the correct NEXT_PUBLIC_API_BASE_URL automatically.
# Example:
# EC2_PUBLIC_IP=54.123.45.67
# NEXT_PUBLIC_API_BASE_URL=http://54.123.45.67:8000
# NEXT_PUBLIC_API_URL=http://54.123.45.67:8000
#
# IMPORTANT: NEXT_PUBLIC_* vars are baked into the Next.js build at compile time.
# They must point to the EC2 public IP, NOT to 'localhost' or 'backend:8000'.
# Never commit a .env file with real EC2 IPs or secrets.
EC2_PUBLIC_IP=<your-ec2-public-ip>

